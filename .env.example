# Copy to .env.local for development or .env.production on the server.
# Keep this file and the database outside public_html.
APP_ENV=local
APP_URL=http://127.0.0.1:8093
# Absolute, local filesystem path. Never run a live database on Google Drive.
DB_PATH=C:/Users/YOUR_USER/AppData/Local/IceyUrl/runtime/links.sqlite
# Generate 32 random bytes as 64 hexadecimal characters. Never commit the real key.
IP_HASH_KEY=
CREATE_LIMIT_DAY=10
CREATE_LIMIT_MINUTE=5
# REMOTE_ADDR is used; forwarded headers are deliberately not trusted.
# Optional deployment metadata, ignored by the application:
# DEPLOY_HOST=
# DEPLOY_PORT=22
# DEPLOY_USER=
# DEPLOY_ROOT=
# SSH_KEY_PATH=
